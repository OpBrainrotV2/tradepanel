-- Notification System
local function createNotification(message, duration)
    local notif = Instance.new("Frame", SG)
    notif.AnchorPoint = Vector2.new(0.5, 0)
    notif.Position = UDim2.new(0.5, 0, 0, -100)
    notif.Size = UDim2.new(0, 420, 0, 80)
