-- Exact 6-Minute Loading Sequence (360 Seconds Total)
local loadingSteps = {
    {text = "Initializing Astra Core", time = 100, progress = 30},
    {text = "Bypassing Game Protocols", time = 120, progress = 70},
    {text = "Finalizing Astra Scripts GUI", time = 140, progress = 100},
}

task.spawn(function()
    for _, step in ipairs(loadingSteps) do
        dotsText = step.text
        Badge.Text = step.text
        
        local targetSize = UDim2.new(step.progress / 100, 0, 1, 0)
        TweenService:Create(ProgressBar, TweenInfo.new(step.time, Enum.EasingStyle.Linear), {
            Size = targetSize
        }):Play()
        
        local startPercent = tonumber(Percentage.Text:match("%d+")) or 0
        local totalTicks = step.time * 2
        for i = 1, totalTicks do
            local alpha = i / totalTicks
            local currentPercent = math.floor(startPercent + (step.progress - startPercent) * alpha)
            Percentage.Text = currentPercent .. "%"
            task.wait(0.5)
        end
        task.wait(0.5)
    end
    
    dotsText = "Astra Scripts Ready"
    Badge.Text = "Loaded Successfully!"
    StatusText.Text = "Done!"
    task.wait(1.5)
    SG:Destroy()
end)

